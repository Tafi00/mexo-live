{
  "name": "@mexo/streamer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MexoStreamer - máy chủ đẩy luồng video lên Shopee Live (FFmpeg/RTMP)",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup src/index.ts --format esm --target node20 --clean",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
