{
  "name": "@mexo/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "migrate:legacy": "tsx src/cli/migrate-legacy.ts",
    "seed:demo": "tsx src/cli/seed-demo.ts",
    "create-admin": "tsx src/cli/create-admin.ts",
    "migrate:legacy:prod": "node dist/cli/migrate-legacy.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.3.0",
    "@mexo/shared": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.0",
    "postgres": "^3.4.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
