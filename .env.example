# ═══════════════════════════════════════════════════════════════
#  MEXO Live 2 — cấu hình API (sao chép thành .env ở thư mục gốc hoặc apps/api)
#
#  BẮT BUỘC trong .env: APP_SECRET, DATABASE_URL, PUBLIC_URL (cần trước khi đọc được database).
#  Các mục đánh dấu [WEB] nhập được trực tiếp tại Cấu hình hệ thống → Kết nối & khóa API
#  (lưu mã hóa trong database, có hiệu lực ngay). Giá trị dưới đây chỉ là mặc định khi chưa nhập trên web.
#  Khóa API AI nhập tại tab Trợ lý AI; khóa máy phát tạo tại trang Máy chủ phát.
# ═══════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Bắt buộc ở production: chuỗi bí mật ≥ 32 ký tự (mã hóa token Shopee, khóa AI, URL đẩy luồng).
# ĐỔI KHÓA NÀY SẼ LÀM MẤT HIỆU LỰC MỌI TOKEN ĐÃ LƯU.
APP_SECRET=

# PostgreSQL. Bỏ trống → dùng PostgreSQL nhúng (PGlite) tại DATA_DIR/pg (chỉ nên dùng cho dev/demo)
DATABASE_URL=postgres://mexo:mexo@localhost:5432/mexo
DATA_DIR=./data
# Thư mục lưu video và ảnh bìa (có thể thay bằng ổ mạng / Object Storage gắn vào)
STORAGE_DIR=./storage

# Địa chỉ web người dùng truy cập (redirect OAuth, kiểm tra Origin)
PUBLIC_URL=https://live.example.vn
# [WEB] Địa chỉ API mà máy phát MexoStreamer gọi tới (thường giống PUBLIC_URL khi API phục vụ cả web)
API_PUBLIC_URL=https://live.example.vn
# Phục vụ giao diện web đã build từ apps/web/dist
SERVE_WEB=true
COOKIE_SECURE=true

# ── Shopee Open Platform ──
# mock = Shopee giả lập (chạy thử), sandbox = môi trường test của Shopee, live = thật
# [WEB]
SHOPEE_MODE=live
# [WEB]
SHOPEE_PARTNER_ID=
# [WEB]
SHOPEE_PARTNER_KEY=
# Redirect URL đã khai báo trong Shopee Open Platform Console (mặc định PUBLIC_URL/connect/callback)
# [WEB]
SHOPEE_REDIRECT_URL=
# [WEB]
SHOPEE_TIMEOUT_MS=15000
# IP tĩnh đã khai báo với Shopee — hệ thống cảnh báo nếu IP ra thực tế khác
# [WEB]
EXPECTED_EGRESS_IP=

# ── Máy phát ──
# [WEB]
STREAMER_MIN_VERSION=1.0.0
# [WEB]
STREAMER_LOST_AFTER_SEC=30

# ── AI trả lời bình luận ──
# Cho phép AI chạy ở mạng nội bộ / http (mặc định chặn)
# [WEB]
API_AI_ALLOW_PRIVATE_HOSTS=false

# ── Tài khoản quản trị tạo ở lần chạy đầu (bắt buộc đổi mật khẩu khi đăng nhập) ──
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Tắt tác vụ nền trên tiến trình này (khi chạy nhiều bản API sau load balancer, chỉ bật ở 1 bản)
JOBS_ENABLED=true
